    {
      "page_id": "p004",
      "image": 4,
      "url": "https://upload.wikimedia.org/wikipedia/commons/9/90/NLC416-13jh007190-105055_%E4%B8%8A%E6%B5%B7%E8%99%B9%E5%8F%A3%E5%90%8C%E4%BB%81%E9%86%AB%E9%99%A2%E6%B8%85%E5%96%AE.pdf#page=4",
      "source_sha256": "f1552582c9f1f1cbbbcf37c4ba25febe8bf7b0f90f105bf8ac99d3dca5c9222a",
      "width": 1223,
      "height": 1600,
      "bytes": 91141,
      "layout_reviewed": true,
      "units": [
        {
          "id": "p004-c01",
          "kind": "heading",
          "layer": "heading",
          "text": "就診條例",
          "bbox": null,
          "order": 0
        },
        {
          "id": "p004-c02",
          "kind": "heading",
          "layer": "heading",
          "text": "一門診",
          "bbox": null,
          "order": 1
        },
        {
          "id": "p004-c03",
          "kind": "body",
          "layer": "body",
          "text": "除禮拜日外每日分上下午門診上午門診為有力者設立自九",
          "bbox": null,
          "order": 2
        },
        {
          "id": "p004-c04",
          "kind": "body",
          "layer": "body",
          "text": "時至十二時止號金洋一元至二元另加藥資下午門診專醫貧",
          "bbox": null,
          "order": 3
        },
        {
          "id": "p004-c05",
          "kind": "body",
          "layer": "body",
          "text": "病自二時至四時止祇取號金錢五十文稍有力者略貼藥資實",
          "bbox": null,
          "order": 4
        },
        {
          "id": "p004-c06",
          "kind": "body",
          "layer": "body",
          "text": "係無力者號金概不收取",
          "bbox": null,
          "order": 5
        },
        {
          "id": "p004-c07",
          "kind": "heading",
          "layer": "heading",
          "text": "一急診",
          "bbox": null,
          "order": 6
        },
        {
          "id": "p004-c08",
          "kind": "body",
          "layer": "body",
          "text": "如有服毒吞金暴病及跌打損傷等症可隨時來院就醫並不收",
          "bbox": null,
          "order": 7
        },
        {
          "id": "p004-c09",
          "kind": "body",
          "layer": "body",
          "text": "費",
          "bbox": null,
          "order": 8
        },
        {
          "id": "p004-c10",
          "kind": "heading",
          "layer": "heading",
          "text": "一住院",
          "bbox": null,
          "order": 9
        },
        {
          "id": "p004-c11",
          "kind": "body",
          "layer": "body",
          "text": "住院病人分內外科及上中下三等貧病毫不取費稍有力者每",
          "bbox": null,
          "order": 10
        },
        {
          "id": "p004-c12",
          "kind": "body",
          "layer": "body",
          "text": "日貼飯資洋二角包住上等房間者其費每日自一元至三元半",
          "bbox": null,
          "order": 11
        },
        {
          "id": "p004-c13",
          "kind": "body",
          "layer": "body",
          "text": "不等住統房間之病人須先貼資一月住包房間之病人須先惠",
          "bbox": null,
          "order": 12
        },
        {
          "id": "p004-c14",
          "kind": "body",
          "layer": "body",
          "text": "費一禮拜如有可靠保人作保無庸先付",
          "bbox": null,
          "order": 13
        },
        {
          "id": "p004-c15",
          "kind": "body",
          "layer": "body",
          "text": "凡外科一切割症不特醫治艱辛並藥類費甚貴故有力病人就",
          "bbox": null,
          "order": 14
        },
        {
          "id": "p004-c16",
          "kind": "running",
          "layer": "running",
          "text": "同仁醫院清單",
          "bbox": null,
          "order": 15
        },
        {
          "id": "p004-c17",
          "kind": "folio",
          "layer": "folio",
          "text": "三",
          "bbox": null,
          "order": 16
        }
      ],

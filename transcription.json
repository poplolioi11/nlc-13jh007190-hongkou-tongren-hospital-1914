    {
      "page_id": "p005",
      "image": 5,
      "url": "https://upload.wikimedia.org/wikipedia/commons/9/90/NLC416-13jh007190-105055_%E4%B8%8A%E6%B5%B7%E8%99%B9%E5%8F%A3%E5%90%8C%E4%BB%81%E9%86%AB%E9%99%A2%E6%B8%85%E5%96%AE.pdf#page=5",
      "source_sha256": "faf52e320058db7c782a78a72afbdfee4e358eae4b588712096df3e7fe3abe0c",
      "width": 1187,
      "height": 1600,
      "bytes": 72223,
